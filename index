    <div class="signatures">
      <div class="sig"><div class="line"></div><b>Sourabh Suneja</b><span>Technical Coordinator</span></div>
      <div class="sig"><div class="line"></div><b>Kajal Jha &amp; Ritu Das</b><span>Activity Coordinators</span></div>
      <div class="sig"><div class="line"></div><b>Mrs. Savita Devi</b><span>Principal</span></div>
    </div>
    <div class="sheet-footer">
      <span>Official Scoreboard — Annual Sports Meet &nbsp;•&nbsp; Scores auto-save in this browser</span>
      <span>Prepared for approval &amp; house display</span>
    </div>
  </div>
</section>

<!-- ===== SHARED MODAL : add result ===== -->
