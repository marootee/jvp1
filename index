        <button data-f="day1" onclick="setFilter('day1')">Day 1</button>
        <button data-f="day2" onclick="setFilter('day2')">Day 2</button>
        <button data-f="day3" onclick="setFilter('day3')">Day 3</button>
      </div>
    </div>
    <div class="screen-right">
      <div class="live"><i></i> Live</div>
      <div class="clock" id="clock">--:--</div>
