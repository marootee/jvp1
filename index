      <button class="vs-btn active" id="btnScreen" onclick="setView('screen')">Big Screen View</button>
      <button class="vs-btn" id="btnTable" onclick="setView('table')">Scoreboard Table View</button>
    </div>
    <button class="ab-btn primary" onclick="openModal()">+ Add Result</button>
    <button class="ab-btn" onclick="toggleFullscreen()">Fullscreen</button>
  </div>
</header>

<!-- ===== VIEW 1 : BIG SCREEN (house display only) ===== -->
<section class="view view-screen" id="viewScreen">
  <div class="screen-head">
    <div>
      <div class="eyebrow">Inter-House Championship &nbsp;•&nbsp; Live Scoreboard</div>
      <h1>Annual Sports <span>Meet</span></h1>
      <span class="school" contenteditable="true" id="schoolScreen" data-school="true">[School Name]</span>
      <div class="day-pills" id="dayPills">
