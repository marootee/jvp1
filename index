</section>

<!-- ===== VIEW 2 : SCOREBOARD TABLE (formal submission for principal) ===== -->
<section class="view view-table" id="viewTable">
  <div class="sheet">
    <div class="sheet-head">
      <svg class="crest" width="72" height="72" viewBox="0 0 72 72" role="img" aria-label="School crest">
        <circle cx="36" cy="36" r="33" fill="#0b2a4a" stroke="#c5a880" stroke-width="3"/>
        <path d="M36 11 L53 18.5 V35 C53 48.5 46.2 57.2 36 62 C25.8 57.2 19 48.5 19 35 V18.5 Z" fill="none" stroke="#c5a880" stroke-width="2.6" stroke-linejoin="round"/>
        <path d="M36 22.5 l3.6 7.3 8 .9 -5.9 5.5 1.5 7.9 -7.2 -4.1 -7.2 4.1 1.5 -7.9 -5.9 -5.5 8 -.9 Z" fill="#c5a880"/>
        <circle cx="36" cy="36" r="2.1" fill="#0b2a4a"/>
      </svg>
      <div>
        <div class="eyebrow">Official Scoreboard &nbsp;•&nbsp; Inter-House Championship</div>
        <h2>Annual Sports Meet — Official Scoreboard</h2>
        <div class="school-line"><b><span contenteditable="true" id="schoolTable" data-school="true">[School Name]</span></b> &nbsp;•&nbsp; Results updated live after every event</div>
