          </div>
        </div>

        <div class="day-card"><div class="day-head d1"><h3>Day 1</h3><span class="count" id="c1"></span></div><div class="day-body" id="day1"></div></div>
        <div class="day-card"><div class="day-head d2"><h3>Day 2</h3><span class="count" id="c2"></span></div><div class="day-body" id="day2"></div></div>
        <div class="day-card"><div class="day-head d3"><h3>Day 3</h3><span class="count" id="c3"></span></div><div class="day-body" id="day3"></div></div>
      </div>

      <!-- RIGHT : settings + summary -->
      <div>
        <div class="card">
          <h2>Points System</h2>
          <div class="sub">Points awarded for new results. Existing entries keep their original points.</div>
          <div class="pts-row">
            <div><label>1st Place</label><input id="pts1" type="number" value="10"></div>
            <div><label>2nd Place</label><input id="pts2" type="number" value="7"></div>
            <div><label>3rd Place</label><input id="pts3" type="number" value="5"></div>
          </div>
          <div class="btn-row no-print">
            <button onclick="openModal()">+ Add Result</button>
            <button onclick="loadSample()">Load Sample Data</button>
            <button class="danger" onclick="clearAll()">Clear All</button>
          </div>
        </div>

        <div class="card">
          <h2>Points by Game Type</h2>
          <div class="sub">Individual vs Team / Grouped contribution per house</div>
          <div id="split"></div>
        </div>

        <div class="card">
          <h2>Meet Summary</h2>
          <div class="stat-grid">
            <div class="stat"><b id="stEvents">0</b><span>Total Events</span></div>
            <div class="stat"><b id="stPoints">0</b><span>Total Points</span></div>
            <div class="stat"><b id="stGold">0</b><span>Gold Medals</span></div>
          </div>
          <div class="btn-row no-print">
            <button onclick="exportCSV()">Export CSV</button>
