    <div class="houses" id="houses"></div>
  </div>

  <div class="ticker">
    <div class="left" id="tickerLeft">Leading House: <b>—</b></div>
    <div class="right" id="tickerRight">Total Events: <b>0</b> &nbsp;•&nbsp; Total Points: <b>0</b> &nbsp;•&nbsp; Gold Medals: <b>0</b></div>
