          <button onclick="exportCSV()">Export CSV</button>
          <button onclick="window.print()">Print Scoreboard</button>
          <button class="danger" onclick="clearAll()">Clear All Data</button>
        </div>
      </div>
    </div>

    <div class="sheet-body">
      <!-- LEFT : standings + day tables -->
      <div>
