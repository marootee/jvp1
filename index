          <h2>Overall Leaderboard</h2>
          <div class="sub">Sorted automatically by points. Change Day to see day-wise standings.</div>
          <div class="tabs" id="tabsTable">
            <button class="tab active" data-f="all" onclick="setFilter('all')">Overall</button>
            <button class="tab" data-f="day1" onclick="setFilter('day1')">Day 1</button>
            <button class="tab" data-f="day2" onclick="setFilter('day2')">Day 2</button>
            <button class="tab" data-f="day3" onclick="setFilter('day3')">Day 3</button>
          </div>
          <div style="overflow-x:auto">
            <table>
              <thead><tr><th>Position</th><th>House</th><th class="num">Gold</th><th class="num">Silver</th><th class="num">Bronze</th><th class="num">Total Points</th><th>Progress</th></tr></thead>
