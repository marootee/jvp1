</div>

<div class="toast" id="toast">Result added successfully.</div>

<script>
const HOUSES=[
  {id:'ruby',name:'Ruby',initial:'R',motto:'House of Courage'},
  {id:'emerald',name:'Emerald',initial:'E',motto:'House of Growth'},
  {id:'topaz',name:'Topaz',initial:'T',motto:'House of Excellence'},
  {id:'sapphire',name:'Sapphire',initial:'S',motto:'House of Honour'},
];
const H=id=>HOUSES.find(h=>h.id===id);
let filter='all', events=[], lastLeader=null;

const SAMPLE=[
  {name:'March Past',day:'day1',type:'grouped',first:'ruby',s1:'',second:'sapphire',s2:'',third:'emerald',s3:'',p1:10,p2:7,p3:5},
  {name:'50m Dash (Girls)',day:'day1',type:'individual',first:'emerald',s1:'Ananya Gupta',second:'ruby',s2:'Ishita Verma',third:'topaz',s3:'Meera Singh',p1:10,p2:7,p3:5},
  {name:'50m Dash (Boys)',day:'day1',type:'individual',first:'sapphire',s1:'Arjun Mehta',second:'emerald',s2:'Kabir Shah',third:'ruby',s3:'Rohan Patel',p1:10,p2:7,p3:5},
  {name:'Sack Race',day:'day1',type:'individual',first:'topaz',s1:'Vivaan Joshi',second:'sapphire',s2:'Ayaan Khan',third:'emerald',s3:'Dev Nair',p1:10,p2:7,p3:5},
  {name:'100m Dash (Boys)',day:'day2',type:'individual',first:'sapphire',s1:'Aditya Rao',second:'ruby',s2:'Nikhil Das',third:'emerald',s3:'Farhan Ali',p1:10,p2:7,p3:5},
  {name:'100m Dash (Girls)',day:'day2',type:'individual',first:'emerald',s1:'Sanya Kapoor',second:'sapphire',s2:'Priya Nair',third:'ruby',s3:'Kavya Reddy',p1:10,p2:7,p3:5},
  {name:'4x100m Relay',day:'day2',type:'team',first:'ruby',s1:'Team Ruby',second:'emerald',s2:'Team Emerald',third:'sapphire',s3:'Team Sapphire',p1:10,p2:7,p3:5},
  {name:'Long Jump',day:'day2',type:'individual',first:'sapphire',s1:'Rahul Menon',second:'topaz',s2:'Yash Thakur',third:'ruby',s3:'Om Prakash',p1:10,p2:7,p3:5},
  {name:'Kho-Kho (Boys)',day:'day3',type:'team',first:'emerald',s1:'Team Emerald',second:'sapphire',s2:'Team Sapphire',third:'',s3:'',p1:10,p2:7,p3:5},
  {name:'Soft Board Decoration (English Extravaganza)',day:'day3',type:'grouped',first:'ruby',s1:'Team Ruby',second:'topaz',s2:'Team Topaz',third:'sapphire',s3:'Team Sapphire',p1:10,p2:7,p3:5},
  {name:'Soft Board Decoration (Hindi Pakhwada)',day:'day3',type:'grouped',first:'emerald',s1:'Team Emerald',second:'sapphire',s2:'Team Sapphire',third:'ruby',s3:'Team Ruby',p1:10,p2:7,p3:5},
  {name:'Soft Board Decoration (7 August)',day:'day3',type:'grouped',first:'emerald',s1:'Team Emerald',second:'topaz',s2:'Team Topaz',third:'sapphire',s3:'Team Sapphire',p1:10,p2:7,p3:5},
  {name:'Kho-Kho (Girls)',day:'day3',type:'team',first:'topaz',s1:'Team Topaz',second:'sapphire',s2:'Team Sapphire',third:'',s3:'',p1:10,p2:7,p3:5},
  {name:'Kabaddi (Boys)',day:'day3',type:'team',first:'ruby',s1:'Team Ruby',second:'topaz',s2:'Team Topaz',third:'',s3:'',p1:10,p2:7,p3:5},
  {name:'200m Dash (Boys)',day:'day3',type:'individual',first:'ruby',s1:'Karan Malhotra',second:'sapphire',s2:'Vikram Singh',third:'topaz',s3:'Sameer Bose',p1:10,p2:7,p3:5},
  {name:'Football (Final)',day:'day3',type:'team',first:'emerald',s1:'Team Emerald',second:'ruby',s2:'Team Ruby',third:'sapphire',s3:'Team Sapphire',p1:10,p2:7,p3:5},
];

function save(){localStorage.setItem('sportsmeet_combined_v5',JSON.stringify(events))}
function load(){
  const s=localStorage.getItem('sportsmeet_combined_v5')||localStorage.getItem('formal_scoreboard_v4')||localStorage.getItem('lively_scoreboard_v3');
  if(s){try{const d=JSON.parse(s); if(Array.isArray(d)&&d.length){events=d; return}}catch(e){}}
  events=JSON.parse(JSON.stringify(SAMPLE));
}
function calc(list){
  const st={}; HOUSES.forEach(h=>st[h.id]={pts:0,g:0,s:0,b:0,ind:0,team:0});
  list.forEach(ev=>{
    const add=(id,pts,m)=>{ if(!id||!st[id])return; st[id].pts+=+pts||0; if(m==='g')st[id].g++; if(m==='s')st[id].s++; if(m==='b')st[id].b++; if(ev.type==='individual')st[id].ind+=+pts||0; else st[id].team+=+pts||0; };
    add(ev.first,ev.p1,'g'); add(ev.second,ev.p2,'s'); add(ev.third,ev.p3,'b');
  }); return st;
}
const filtered=()=>filter==='all'?events:events.filter(e=>e.day===filter);

function winnerCell(houseId, studentName, type){
  if(!houseId) return '<span class="house-tag nil">NIL</span>';
  const h=H(houseId);
  const name=(studentName&&studentName.trim())?studentName:(type==='individual'?'—':'Team '+h.name);
  return `<div class="winner"><div class="student">${name}</div><span class="house-tag ${houseId}">${h.name} House</span></div>`;
}

function render(){
  const list=filtered(), stats=calc(list), overall=calc(events);
  const max=Math.max(1,...Object.values(stats).map(s=>s.pts));
  const sorted=[...HOUSES].sort((a,b)=>stats[b.id].pts-stats[a.id].pts||stats[b.id].g-stats[a.id].g||a.name.localeCompare(b.name));
  const overallSorted=[...HOUSES].sort((a,b)=>overall[b.id].pts-overall[a.id].pts||overall[b.id].g-overall[a.id].g);

  /* ---- BIG SCREEN : houses always in ONE row of 4, sorted live ---- */
  document.getElementById('houses').innerHTML=sorted.map((h,i)=>{
    const s=stats[h.id], pct=Math.round(s.pts/max*100), isLeader=(i===0&&s.pts>0);
    return `<div class="house ${h.id} ${isLeader?'leader':''}" style="animation-delay:${i*0.08}s">
      <div class="rank-row"><div class="rank">${i+1}<small>Position</small></div><span class="badge ${isLeader?'leading':''}">${isLeader?'Leading House':'House'}</span></div>
      <div class="initial">${h.initial}</div>
      <h2>${h.name} House</h2><div class="motto">${h.motto}</div>
      <div class="points"><b>${s.pts}</b><span>Points</span></div>
      <div class="medals"><span>Gold: ${s.g}</span><span>Silver: ${s.s}</span><span>Bronze: ${s.b}</span></div>
      <div class="bar"><i style="width:${pct}%"></i></div>
      <div class="bar-label">${pct}% of leading house</div>
    </div>`;
  }).join('');

  const champ=overallSorted[0], lastEv=events[events.length-1];
  document.getElementById('tickerLeft').innerHTML = overall[champ.id].pts>0
    ? `Leading House: <b>${champ.name} House</b> &nbsp;•&nbsp; ${overall[champ.id].pts} Points &nbsp;•&nbsp; ${overall[champ.id].g} Gold`+(lastEv?` &nbsp;•&nbsp; Latest: ${lastEv.name} — ${(H(lastEv.first)||{}).name||''} House wins`:'')
    : 'Awaiting first result — Best of luck to all houses!';
  document.getElementById('tickerRight').innerHTML=`Total Events: <b>${events.length}</b> &nbsp;•&nbsp; Total Points: <b>${Object.values(overall).reduce((a,s)=>a+s.pts,0)}</b> &nbsp;•&nbsp; Gold Medals: <b>${Object.values(overall).reduce((a,s)=>a+s.g,0)}</b>`;

  if(lastLeader && lastLeader!==champ.id && overall[champ.id].pts>0){ confettiBurst(); }
  lastLeader=champ.id;

  /* ---- TABLE VIEW : leaderboard (same sorted order) ---- */
  document.getElementById('leaderBody').innerHTML=sorted.map((h,i)=>{
    const s=stats[h.id], pct=Math.round(s.pts/max*100);
    return `<tr class="row-${h.id}${i===0&&s.pts>0?' row-leading':''}">
      <td><b>${i+1}</b>${i===0&&s.pts>0?' — Leading':''}</td>
      <td><div class="house-cell"><span class="dot ${h.id}">${h.initial}</span>${h.name} House</div></td>
      <td class="num">${s.g}</td><td class="num">${s.s}</td><td class="num">${s.b}</td>
      <td class="num" style="font-size:16px;color:var(--navy)">${s.pts}</td>
      <td><div class="progress"><i style="width:${pct}%"></i></div></td>
    </tr>`;
  }).join('');

  /* ---- TABLE VIEW : split chart ---- */
  document.getElementById('split').innerHTML=HOUSES.map(h=>{
    const s=overall[h.id], tot=(s.ind+s.team)||1, ip=Math.round(s.ind/tot*100), tp=100-ip;
    return `<div class="split-row"><div class="lbl"><span>${h.name} House</span><span>${s.pts} pts</span></div>
      <div class="stack"><i style="width:${ip}%;background:#1d4ed8"></i><i style="width:${tp}%;background:#be123c"></i></div>
      <div style="font-size:11px;color:#64748b;margin-top:4px">Individual: ${s.ind} pts (${ip}%) &nbsp;•&nbsp; Team / Grouped: ${s.team} pts (${tp}%)</div></div>`;
  }).join('');

  /* ---- TABLE VIEW : day tables with student name + house tag, NO class column ---- */
  [['day1','day1','c1'],['day2','day2','c2'],['day3','day3','c3']].forEach(([day,elId,cId])=>{
    const l=events.filter(e=>e.day===day);
    document.getElementById(cId).textContent=l.length+(l.length===1?' event':' events');
    const el=document.getElementById(elId);
    if(!l.length){el.innerHTML='<div class="empty">No results recorded for Day '+day.slice(-1)+' yet.</div>';return;}
    const st=calc(l);
    el.innerHTML=`<table>
      <thead><tr><th>Event</th><th>Type</th><th>1st Place</th><th>2nd Place</th><th>3rd Place</th><th class="num">Points</th><th class="no-print"></th></tr></thead>
      <tbody>${l.map(ev=>{const idx=events.indexOf(ev);return `<tr${ev.first?` class="row-${ev.first}"`:''}>
        <td style="font-weight:700;min-width:160px">${ev.name}</td>
        <td><span class="type ${ev.type}">${ev.type}</span></td>
        <td>${winnerCell(ev.first,ev.s1,ev.type)}</td>
        <td>${winnerCell(ev.second,ev.s2,ev.type)}</td>
        <td>${winnerCell(ev.third,ev.s3,ev.type)}</td>
        <td class="num">${ev.p1} / ${ev.p2} / ${ev.p3}</td>
        <td class="no-print"><button class="del" onclick="delEvent(${idx})" title="Delete">×</button></td>
      </tr>`}).join('')}</tbody></table>
      <div class="day-total">Day ${day.slice(-1)} Totals &nbsp;—&nbsp; Ruby: <b>${st.ruby.pts}</b> &nbsp;•&nbsp; Emerald: <b>${st.emerald.pts}</b> &nbsp;•&nbsp; Topaz: <b>${st.topaz.pts}</b> &nbsp;•&nbsp; Sapphire: <b>${st.sapphire.pts}</b></div>`;
  });

  document.getElementById('stEvents').textContent=events.length;
  document.getElementById('stPoints').textContent=Object.values(overall).reduce((a,s)=>a+s.pts,0);
  document.getElementById('stGold').textContent=Object.values(overall).reduce((a,s)=>a+s.g,0);
}

/* ===== views ===== */
function setView(v){document.body.dataset.view=v;document.getElementById('btnScreen').classList.toggle('active',v==='screen');document.getElementById('btnTable').classList.toggle('active',v==='table');localStorage.setItem('sportsmeet_view',v);}
function setFilter(f){
  filter=f;
  document.querySelectorAll('#dayPills button,#tabsTable .tab').forEach(b=>b.classList.toggle('active',b.dataset.f===f));
  render();
}
function fillSelects(){const o=HOUSES.map(h=>`<option value="${h.id}">${h.name} House</option>`).join(''),n='<option value="">NIL</option>';const e1=document.getElementById('ev1'),e2=document.getElementById('ev2'),e3=document.getElementById('ev3');e1.innerHTML=o;e2.innerHTML=n+o;e3.innerHTML=n+o;}
function updateStudentLabels(){const isInd=document.getElementById('evType').value==='individual';const ph=isInd?'Student name':'Team / Participant (optional)';['1','2','3'].forEach(n=>{document.getElementById('lblS'+n).textContent=(isInd?n+' — Student Name':n+' — Team / Participant (Optional)')});['s1','s2','s3'].forEach(id=>document.getElementById(id).placeholder=ph);}
function openModal(){document.getElementById('modal').classList.add('open')}
function closeModal(){document.getElementById('modal').classList.remove('open')}
function toggleFullscreen(){if(!document.fullscreenElement){document.documentElement.requestFullscreen().catch(()=>{})}else{document.exitFullscreen()}}
function addEvent(){
  const name=document.getElementById('evName').value.trim(); if(!name){alert('Please enter event name.');return;}
  const type=document.getElementById('evType').value, s1=document.getElementById('s1').value.trim();
  if(type==='individual' && !s1){alert('For Individual games, please enter the 1st place student name.');document.getElementById('s1').focus();return;}
  events.push({name,day:document.getElementById('evDay').value,type,first:document.getElementById('ev1').value,s1,second:document.getElementById('ev2').value,s2:document.getElementById('s2').value.trim(),third:document.getElementById('ev3').value,s3:document.getElementById('s3').value.trim(),p1:+document.getElementById('evP1').value||10,p2:+document.getElementById('pts2').value||7,p3:+document.getElementById('pts3').value||5});
  save();render();closeModal();
  document.getElementById('evName').value='';document.getElementById('s1').value='';document.getElementById('s2').value='';document.getElementById('s3').value='';
  showToast('Result added — scoreboard updated.'); confettiBurst();
}
function delEvent(i){if(confirm('Delete this result?')){events.splice(i,1);save();render()}}
function loadSample(){if(confirm('Load sample data? This replaces current entries.')){events=JSON.parse(JSON.stringify(SAMPLE));save();render()}}
function clearAll(){if(confirm('Clear all events and scores?')){events=[];save();render()}}
function exportCSV(){
  let csv='Event,Day,Type,1st Student,1st House,2nd Student,2nd House,3rd Student,3rd House,Pts 1st,Pts 2nd,Pts 3rd\n';
  events.forEach(e=>{csv+=`"${e.name}",${e.day},${e.type},"${e.s1||''}",${(H(e.first)||{}).name||'NIL'},"${e.s2||''}",${(H(e.second)||{}).name||'NIL'},"${e.s3||''}",${(H(e.third)||{}).name||'NIL'},${e.p1},${e.p2},${e.p3}\n`});
  csv+='\nHouse,Total Points,Gold,Silver,Bronze\n';const st=calc(events);HOUSES.forEach(h=>csv+=`${h.name},${st[h.id].pts},${st[h.id].g},${st[h.id].s},${st[h.id].b}\n`);
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download='sports-meet-scoreboard.csv';a.click();
}
function showToast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600)}
function confettiBurst(){
  const c=document.getElementById('confetti'),ctx=c.getContext('2d');c.width=innerWidth;c.height=innerHeight;
  const cols=['#e11d48','#059669','#d97706','#2563eb','#f59e0b','#ffffff'];
  const parts=Array.from({length:80},()=>({x:Math.random()*c.width,y:-20-Math.random()*80,vx:(Math.random()-.5)*3,vy:2+Math.random()*3.2,s:5+Math.random()*7,col:cols[Math.floor(Math.random()*cols.length)],r:Math.random()*Math.PI}));
  let f=0;(function anim(){ctx.clearRect(0,0,c.width,c.height);parts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.r+=.08;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r);ctx.fillStyle=p.col;ctx.fillRect(-p.s/2,-p.s/2,p.s,p.s*.6);ctx.restore()});if(++f<105)requestAnimationFrame(anim);else ctx.clearRect(0,0,c.width,c.height)})();
}
function tickClock(){const d=new Date();document.getElementById('clock').textContent=d.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit'});}
setInterval(tickClock,1000);tickClock();
document.getElementById('modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});
document.getElementById('evName').addEventListener('keydown',e=>{if(e.key==='Enter')addEvent()});
document.getElementById('pts1').addEventListener('input',()=>document.getElementById('evP1').value=document.getElementById('pts1').value);
/* sync school name across both views + remember it */
const savedSchool=localStorage.getItem('sportsmeet_school');
if(savedSchool){document.querySelectorAll('[data-school]').forEach(el=>el.textContent=savedSchool);}
document.querySelectorAll('[data-school]').forEach(el=>el.addEventListener('input',()=>{const v=el.textContent.trim();localStorage.setItem('sportsmeet_school',v);document.querySelectorAll('[data-school]').forEach(o=>{if(o!==el)o.textContent=v;});}));
/* restore last view */
const savedView=localStorage.getItem('sportsmeet_view'); if(savedView==='table'||savedView==='screen'){document.body.dataset.view=savedView;}
load();fillSelects();updateStudentLabels();render();
setView(document.body.dataset.view||'screen');
</script>
</body>
</html>
